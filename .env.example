# Environment for the Coolify resource. Paste into the resource's
# Environment Variables (Developer view). Generate secrets: openssl rand -hex 32

## Public URLs -- two hostnames under one parent domain. Must match the
## domains assigned to the services in Coolify (https, no trailing slash).
DRUPAL_FRONTEND_BASE_URL=https://kb.example.com
DRUPAL_BASE_URL=https://kb-admin.example.com
# Common parent domain with a leading dot; scopes the session cookie.
SESSION_COOKIE_DOMAIN=.example.com

## Secrets -- required
DRUPAL_HASH_SALT=
MARIADB_PASSWORD=
MARIADB_ROOT_PASSWORD=
OKB_COLLAB_CLIENT_ID=
OKB_COLLAB_CLIENT_SECRET=

## Optional
#ADMIN_PASSWORD=
#OPENAI_API_KEY=
#ANTHROPIC_API_KEY=
#MISTRAL_API_KEY=
#MAILER_DSN=smtp://user:pass@smtp.example.com:587
#MAIL_FROM=kb@example.com
#WEBSERVER_UPLOAD_MAX_SIZE=100MB

## Versions (defaults are set in docker-compose.yml)
#OPENKB_TAG=1.0.0-beta2
#OPENKB_MARIADB_IMAGE=mariadb:11.4.13
#OPENKB_OPENSEARCH_IMAGE=opensearchproject/opensearch:3.9.0

## OpenSearch. Set ALLOW_MMAP=false if the host lacks vm.max_map_count=262144.
#OPENSEARCH_ALLOW_MMAP=true
#OPENSEARCH_JAVA_OPTS=-Xms512m -Xmx512m
